{
"name": "sparkhope-monorepo-root",
"version": "1.0.0",
"private": true,
"description": "Root package.json to manage the monorepo settings for Sparkhope Lab.",
"packageManager": "pnpm@9.0.6",

"scripts": {
"build": "pnpm -r build",
"start": "pnpm --filter ./apps/* start"
},
"engines": {
"node": ">=18.0.0",
"pnpm": ">=9.0.0"
},
"dependencies": {
    "@astrojs/starlight": "^0.36.0",
    "astro": "^5.14.3",
    "chart.js": "^4.5.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.10.1",
    "sharp": "^0.34.2"
},
"devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.5.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.34.0",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.13.0",
    "typescript": "^5.9.2"
},
"scripts": {
    "dev": "pnpm --filter site-en dev",
    "dev:es": "pnpm --filter site-es dev",
    "build": "pnpm -r --filter './packages/site-*' build",
    "build:en": "pnpm --filter site-en build",
    "build:es": "pnpm --filter site-es build",
    "preview:en": "pnpm --filter site-en preview",
    "preview:es": "pnpm --filter site-es preview"
},
"exports": {
    "./Layout.astro": "./src/layouts/Layout.astro",
    "./LanguageSwitcher.astro": "./src/components/LanguageSwitcher.astro",
    "./botanical-theme.css": "./src/styles/botanical-theme.css",
    "./lib/initData.js": "./src/lib/initData.js",
    "./lib/managers": "./src/lib/managers/index.js",
    "./lib/DataManager.js": "./src/lib/DataManager.js",
    "./types": "./src/types/database.ts"
  }
}
