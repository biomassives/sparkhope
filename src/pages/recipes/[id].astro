---
// src/pages/recipes/[id].astro - FIXED
import Layout from '../../layouts/Layout.astro';
import { initializeDataStore } from '../../lib/initData.js';

const { id } = Astro.params;

const store = await initializeDataStore();
const allRecipes = await store.recipes.getAll();

// Find the specific recipe
const recipe = allRecipes.find((r: any) => 
  r.id === id
);

if (!recipe) {
  return Astro.redirect('/404');
}

// Export getStaticPaths for static site generation
export async function getStaticPaths() {
  const store = await initializeDataStore();
  const recipes = await store.recipes.getAll();
  
  return recipes.map((recipe: any) => ({
    params: { id: recipe.id },
  }));
}

// Get related data
const allSpecies = await store.species.getAll();

// Ingredients are nested in the recipe
const recipeIngredients = recipe.ingredients || [];

const suitableSpecies = recipe.suitable_species
  ? allSpecies.filter((s: any) => recipe.suitable_species.includes(s.species_id || s.id))
  : [];
---

<Layout title={`${recipe.name || 'Recipe'} - SparkHope`}>
  <div class="container">
    <div class="recipe-header">
      <div class="header-content">
        <h1>{recipe.name || 'Untitled Recipe'}</h1>
        <div class="header-badges">
          {recipe.type && (
            <span class="badge badge-type">{recipe.type}</span>
          )}
          {recipe.difficulty && (
            <span class={`badge badge-${recipe.difficulty}`}>
              {recipe.difficulty}
            </span>
          )}
        </div>
      </div>
    </div>

    {recipe.description && (
      <div class="section">
        <h2>Description</h2>
        <p>{recipe.description}</p>
      </div>
    )}

    {recipe.preparation && (
      <div class="section">
        <h2>Preparation</h2>
        <p>{recipe.preparation}</p>
      </div>
    )}


    <div class="info-grid">
      {recipe.sterilization_method && (
        <div class="info-card">
          <h3>Sterilization Method</h3>
          <p>{recipe.sterilization_method}</p>
        </div>
      )}

      {recipe.yield && (
        <div class="info-card">
          <h3>Expected Yield</h3>
          <p>{recipe.yield}</p>
        </div>
      )}
    </div>

    {recipeIngredients.length > 0 && (
      <div class="section">
        <h2>Ingredients ({recipeIngredients.length})</h2>
        <div class="ingredient-grid">
          {recipeIngredients.map((ingredient: any) => (
            <div class="ingredient-card">
              <h3>{ingredient.name}</h3>
              {(ingredient.amount || ingredient.unit) && (
                <p class="ingredient-amount">
                  {ingredient.amount} {ingredient.unit || ''}
                </p>
              )}
              {ingredient.notes && (
                <p class="ingredient-notes">{ingredient.notes}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    {recipe.instructions && recipe.instructions.length > 0 && (
      <div class="section">
        <h2>Instructions</h2>
        <ol class="instructions-list">
          {recipe.instructions.map((instruction: string, index: number) => (
            <li>
              <span class="step-number">{index + 1}</span>
              <span class="step-text">{instruction}</span>
            </li>
          ))}
        </ol>
      </div>
    )}

    {suitableSpecies.length > 0 && (
      <div class="section">
        <h2>Suitable Species ({suitableSpecies.length})</h2>
        <div class="species-grid">
          {suitableSpecies.map((species: any) => (
            <a href={`/species/${species.species_id || species.id}`} class="species-card">
              <h3>{species.title || species.scientific_name}</h3>
              {species.scientific_name && species.title !== species.scientific_name && (
                <p class="scientific-name">{species.scientific_name}</p>
              )}
              {species.difficulty && (
                <span class={`badge badge-${species.difficulty}`}>
                  {species.difficulty}
                </span>
              )}
            </a>
          ))}
        </div>
      </div>
    )}

    {recipe.tags && recipe.tags.length > 0 && (
      <div class="section">
        <h2>Tags</h2>
        <div class="tag-list">
          {recipe.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
    )}

    <div class="actions">
      <a href="/recipes" class="btn-secondary">← Back to Recipes</a>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .recipe-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .recipe-header h1 {
    font-size: 2.5rem;
    margin: 0;
    flex: 1;
  }

  .header-badges {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .badge {
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge-type {
    background: var(--color-bg-card-hover);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .badge-beginner {
    background: #065f46;
    color: #d1fae5;
  }

  .badge-intermediate {
    background: #78350f;
    color: #fef3c7;
  }

  .badge-advanced {
    background: #7f1d1d;
    color: #fee2e2;
  }

  .badge-easy {
    background: #065f46;
    color: #d1fae5;
  }

  .badge-moderate {
    background: #78350f;
    color: #fef3c7;
  }

  .badge-challenging {
    background: #7f1d1d;
    color: #fee2e2;
  }

  .section {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .section h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .section p {
    color: var(--color-text-dim);
    line-height: 1.6;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .info-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .info-card h3 {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-dim);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .info-card p {
    font-size: 1.125rem;
    color: var(--color-text);
    margin: 0;
  }

  .ingredient-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .ingredient-card {
    background: var(--color-bg-card-hover);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
    transition: all 0.2s;
  }

  .ingredient-card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  .ingredient-card h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .ingredient-amount {
    font-size: 0.875rem;
    color: var(--sl-color-accent-high);
    font-weight: 600;
    margin: 0.5rem 0;
  }

  .ingredient-notes {
    font-size: 0.875rem;
    color: var(--color-text-dim);
    margin: 0.5rem 0;
    font-style: italic;
  }

  .instructions-list {
    list-style: none;
    padding: 0;
    counter-reset: step-counter;
  }

  .instructions-list li {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    margin-bottom: 0.5rem;
    background: var(--color-bg-card-hover);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    counter-increment: step-counter;
  }

  .step-number {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sl-color-accent);
    color: white;
    border-radius: 50%;
    font-weight: 600;
    font-size: 0.875rem;
  }

  .step-text {
    flex: 1;
    line-height: 1.6;
    color: var(--color-text);
  }

  .species-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .species-card {
    background: var(--color-bg-card-hover);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .species-card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  .species-card h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .scientific-name {
    font-size: 0.875rem;
    color: var(--color-text-dim);
    font-style: italic;
    margin: 0.5rem 0;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--color-bg-card-hover);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .actions {
    margin-top: 2rem;
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-bg-card);
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--sl-color-accent);
  }

  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
    }

    .header-badges {
      flex-direction: row;
    }

    .recipe-header h1 {
      font-size: 2rem;
    }

    .ingredient-grid,
    .species-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
