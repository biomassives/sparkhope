  }

  .grid-icon {
    font-size: 1rem;
  }

  .grid-text {
    font-weight: 500;
    color: var(--color-text);
  }

  .grid-dimensions {
    color: var(--color-text-dim);
    font-size: 0.75rem;
  }

  .rack-notes {
    color: var(--color-text-dim);
    line-height: 1.6;
    margin: 0;
    font-size: 0.875rem;
    font-style: italic;
    padding: 0.75rem;
