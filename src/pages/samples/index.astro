---
// src/pages/samples/index.astro - COMPLETE CLEAN VERSION
import Layout from '../../layouts/Layout.astro';
import { initializeDataStore } from '../../lib/initData.js';
import type { Sample, Rack } from '../../types/database';

const store = await initializeDataStore();
const samples: Sample[] = await store.samples.getAll();
const racks: Rack[] = await store.racks.getAll();
const allSpecies = await store.species.getAll();

// Group samples by type
const samplesByType = samples.reduce((acc: any, sample: Sample) => {
  const type = sample.sample_type || 'other';
  if (!acc[type]) acc[type] = [];
  acc[type].push(sample);
  return acc;
}, {});

// Calculate stats
const totalContaminated = samples.filter(s => s.contamination).length;
const totalReady = samples.filter(s => s.status === 'ready').length;
---

<Layout title="Samples - SparkHope">
  <div class="hero-small">
    <div class="container">
      <h1>🧫 Samples</h1>
      <p class="subtitle">Track cultures and specimens</p>
    </div>
  </div>

  <div class="container">
    <!-- Stats Cards -->
    <div class="stats">
      <div class="stat-card stat-highlight">
        <span class="stat-number">{samples.length}</span>
        <span class="stat-label">Total Samples</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">{totalReady}</span>
        <span class="stat-label">Ready</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">{totalContaminated}</span>
        <span class="stat-label">Contaminated</span>
      </div>
      {Object.entries(samplesByType).map(([type, items]: [string, any]) => (
        <div class="stat-card">
          <span class="stat-number">{items.length}</span>
          <span class="stat-label">{type.replace(/_/g, ' ')}</span>
        </div>
      ))}
    </div>

    {samples.length === 0 ? (
      <div class="empty-state">
        <p>No samples found. Create your first sample to get started!</p>
        <a href="/samples/new" class="btn-primary">Add First Sample</a>
      </div>
    ) : (
      <>
        <!-- Table View -->
        <div class="table-container">
          <table class="sample-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Species</th>
                <th>Batch</th>
                <th>Rack / Position</th>
                <th>Status</th>
                <th>Health</th>
                <th>Contam.</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              {samples.map((s: Sample) => {
                const rack = racks.find((r: Rack) => r.id === s.location_id);
                const species = allSpecies.find((sp: any) => sp.id === s.species_id);
                
                return (
                  <tr>
                    <td><a href={`/samples/${s.id}`}>{s.id}</a></td>
                    <td>{s.sample_type.replace(/_/g, ' ')}</td>
                    <td>{species ? species.common_name : s.species_id}</td>
                    <td>{s.batch_id ?? '—'}</td>
                    <td>
                      {rack ? `${rack.name} / ${s.position || '?'}` : `? / ${s.position || '?'}`}
                    </td>
                    <td>
                      <span class={`status-badge status-${s.status}`}>
                        {s.status}
                      </span>
                    </td>
                    <td class="health-cell">
                      {s.health_rating ? '★'.repeat(s.health_rating) + '☆'.repeat(5 - s.health_rating) : '—'}
                    </td>
                    <td class="contam-cell">
                      {s.contamination ? '⚠️' : '✓'}
                    </td>
                    <td class="notes-cell">{s.notes || '—'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <!-- Add New Button -->
        <div class="add-section">
          <a href="/samples/new" class="btn-secondary">+ Add New Sample</a>
        </div>
      </>
    )}
  </div>
</Layout>

<style>
  .hero-small {
    background: linear-gradient(135deg, var(--sl-color-accent) 0%, var(--sl-color-accent-low) 100%);
    color: white;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .hero-small h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: white;
  }

  .subtitle {
    font-size: 1.125rem;
    opacity: 0.9;
    margin: 0;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    border-radius: 0.75rem;
    text-align: center;
    transition: all 0.2s;
  }

  .stat-card:hover {
    background: var(--color-bg-card-hover);
    transform: translateY(-2px);
  }

  .stat-highlight {
    border-color: var(--sl-color-accent);
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: var(--sl-color-accent-high);
  }

  .stat-label {
    display: block;
    color: var(--color-text-dim);
    margin-top: 0.5rem;
    text-transform: capitalize;
  }

  /* Table Styles */
  .table-container {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .sample-table {
    width: 100%;
    border-collapse: collapse;
  }

  .sample-table th {
    background: var(--color-bg-card-hover);
    color: var(--color-text);
    font-weight: 600;
    text-align: left;
    padding: 1rem;
    border-bottom: 2px solid var(--color-border);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sample-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.875rem;
  }

  .sample-table tbody tr {
    transition: background 0.2s;
  }

  .sample-table tbody tr:hover {
    background: var(--color-bg-card-hover);
  }

  .sample-table td a {
    color: var(--sl-color-accent-high);
    text-decoration: none;
    font-weight: 500;
  }

  .sample-table td a:hover {
    text-decoration: underline;
  }

  .status-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .status-colonizing {
    background: #1e3a8a;
    color: #dbeafe;
  }

  .status-ready {
    background: #065f46;
    color: #d1fae5;
  }

  .status-contaminated {
    background: #7f1d1d;
    color: #fee2e2;
  }

  .status-stored {
    background: #78350f;
    color: #fef3c7;
  }

  .health-cell {
    color: #fbbf24;
    font-size: 1rem;
  }

  .contam-cell {
    text-align: center;
    font-size: 1.25rem;
  }

  .notes-cell {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-text-dim);
  }

  .empty-state {
    background: var(--color-bg-card);
    border: 2px dashed var(--color-border);
    border-radius: 0.75rem;
    padding: 3rem;
    text-align: center;
  }

  .empty-state p {
    color: var(--color-text-dim);
    font-size: 1.125rem;
    margin-bottom: 1.5rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--sl-color-accent);
    color: white;
    border: none;
  }

  .btn-primary:hover {
    background: var(--sl-color-accent-high);
  }

  .btn-secondary {
    background: var(--color-bg-card);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--sl-color-accent);
  }

  .add-section {
    margin-top: 2rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .table-container {
      overflow-x: auto;
    }

    .sample-table {
      min-width: 800px;
    }

    .stats {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }
  }
</style>