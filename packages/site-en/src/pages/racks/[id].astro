---
// src/pages/racks/[id].astro - ENHANCED (Botanical Theme)
import Layout from '../../layouts/Layout.astro';
import { getAllSamples, getSampleById, getAllProjects, getProjectById, getAllSpecies, getSpeciesById, getAllBatches, getBatchById, getAllRecipes, getRecipeById, getAllObservations, getObservationById, getAllRacks, getRackById, getAllIngredients, getIngredientById } from '../../utils/loadData';

const { id } = Astro.params;

const allRacks = getAllRacks();

// Find the specific rack
const rack = allRacks.find((r: any) => 
  r.id === id
);

if (!rack) {
  return Astro.redirect('/404');
}

// Export getStaticPaths for static site generation
export async function getStaticPaths() {
  const racks = getAllRacks();
  
  return racks.map((rack: any) => ({
    params: { id: rack.id },
  }));
}

// Get related data
const allSpecies = getAllSpecies();
const allProjects = getAllProjects();
const allRecipes = getAllRecipes();

// Get species currently on this rack
const speciesOnRack = rack.current_species 
  ? allSpecies.filter((s: any) => rack.current_species.includes(s.species_id || s.id))
  : [];

// Get projects using this rack
const relatedProjects = rack.project_ids
  ? allProjects.filter((p: any) => rack.project_ids.includes(p.id))
  : [];

// Calculate occupancy percentage
const occupancyPercentage = rack.capacity && rack.current_occupancy !== undefined
  ? Math.round((rack.current_occupancy / rack.capacity) * 100)
  : 0;

// Get contamination stats
const contaminatedContainers = rack.containers?.filter((c: any) => c.status === 'contaminated').length || 0;
const activeContainers = rack.containers?.filter((c: any) => c.status === 'occupied' || c.status === 'active').length || 0;

// Get recipes used in this rack
const usedRecipeIds = rack.containers?.map((c: any) => c.recipe_id).filter(Boolean) || [];
const uniqueRecipeIds = [...new Set(usedRecipeIds)];
const usedRecipes = uniqueRecipeIds.map(recipeId => 
  allRecipes.find((r: any) => r.id === recipeId)
).filter(Boolean);
---

<Layout title={`${rack.name || 'Rack'} - SparkHope`}>
  <div class="container">
    <div class="rack-header">
      <div class="header-content">
        <h1>{rack.name || 'Untitled Rack'}</h1>
        <div class="header-badges">
          {rack.status && (
            <span class={`badge badge-status badge-${rack.status}`}>
              {rack.status}
            </span>
          )}
          {rack.type && (
            <span class="badge badge-type">{rack.type}</span>
          )}
          {rack.zone && (
            <span class="badge badge-zone">{rack.zone}</span>
          )}
        </div>
      </div>
    </div>

    {rack.description && (
      <div class="section description-section">
        <h2>Description</h2>
        <p>{rack.description}</p>
      </div>
    )}

    <!-- Enhanced Stats Overview -->
    <div class="stats-overview">
      <div class="stat-card">
        <div class="stat-value">{occupancyPercentage}%</div>
        <div class="stat-label">Occupancy</div>
        <div class="progress-bar">
          <div class="progress-fill" style={`width: ${occupancyPercentage}%`}></div>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-value">{activeContainers}</div>
        <div class="stat-label">Active Containers</div>
      </div>
      
      {contaminatedContainers > 0 && (
        <div class="stat-card warning">
          <div class="stat-value">{contaminatedContainers}</div>
          <div class="stat-label">Contaminated</div>
        </div>
      )}
      
      <div class="stat-card">
        <div class="stat-value">{speciesOnRack.length}</div>
        <div class="stat-label">Species Types</div>
      </div>
    </div>

    <!-- Environmental Conditions -->
    <div class="section environmental-section">
      <h2>Environmental Conditions</h2>
      <div class="environment-grid">
        {rack.temperature !== undefined && (
          <div class="env-card">
            <div class="env-icon">🌡️</div>
            <div class="env-info">
              <div class="env-value">{rack.temperature}°C</div>
              <div class="env-label">Temperature</div>
              {rack.temp_range && (
                <div class="env-range">Range: {rack.temp_range}</div>
              )}
            </div>
          </div>
        )}

        {rack.humidity !== undefined && (
          <div class="env-card">
            <div class="env-icon">💧</div>
            <div class="env-info">
              <div class="env-value">{rack.humidity}%</div>
              <div class="env-label">Humidity</div>
              {rack.humidity_range && (
                <div class="env-range">Range: {rack.humidity_range}</div>
              )}
            </div>
          </div>
        )}

        {rack.light_cycle && (
          <div class="env-card">
            <div class="env-icon">💡</div>
            <div class="env-info">
              <div class="env-value">{rack.light_cycle}</div>
              <div class="env-label">Light Cycle</div>
              {rack.light_intensity && (
                <div class="env-range">Intensity: {rack.light_intensity}</div>
              )}
            </div>
          </div>
        )}

        {rack.co2_level !== undefined && (
          <div class="env-card">
            <div class="env-icon">🌬️</div>
            <div class="env-info">
              <div class="env-value">{rack.co2_level} ppm</div>
              <div class="env-label">CO₂ Level</div>
            </div>
          </div>
        )}

        {rack.air_exchange && (
          <div class="env-card">
            <div class="env-icon">🔄</div>
            <div class="env-info">
              <div class="env-value">{rack.air_exchange}</div>
              <div class="env-label">Air Exchange</div>
            </div>
          </div>
        )}

        {rack.location && (
          <div class="env-card">
            <div class="env-icon">📍</div>
            <div class="env-info">
              <div class="env-value">{rack.location}</div>
              <div class="env-label">Location</div>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Rack Details -->
    <div class="info-grid">
      {rack.capacity && (
        <div class="info-card">
          <h3>Total Capacity</h3>
          <p>{rack.capacity} containers</p>
        </div>
      )}

      {rack.current_occupancy !== undefined && (
        <div class="info-card">
          <h3>Current Occupancy</h3>
          <p>{rack.current_occupancy} / {rack.capacity || '?'}</p>
        </div>
      )}

      {rack.available_slots !== undefined && (
        <div class="info-card">
          <h3>Available Slots</h3>
          <p>{rack.available_slots}</p>
        </div>
      )}

      {rack.shelf_count && (
        <div class="info-card">
          <h3>Shelf Count</h3>
          <p>{rack.shelf_count} shelves</p>
        </div>
      )}

      {rack.dimensions && (
        <div class="info-card">
          <h3>Dimensions</h3>
          <p>{rack.dimensions}</p>
        </div>
      )}

      {rack.material && (
        <div class="info-card">
          <h3>Material</h3>
          <p>{rack.material}</p>
        </div>
      )}
    </div>

    <!-- Enhanced Containers Section -->
    {rack.containers && rack.containers.length > 0 && (
      <div class="section">
        <h2>Containers ({rack.containers.length})</h2>
        <div class="container-filters">
          <button class="filter-btn active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="occupied">Occupied</button>
          <button class="filter-btn" data-filter="available">Available</button>
          <button class="filter-btn" data-filter="contaminated">Contaminated</button>
        </div>
        <div class="container-grid">
          {rack.containers.map((container: any, index: number) => (
            <div class={`container-card container-${container.status || 'empty'}`} data-status={container.status}>
              <div class="container-header">
                <h3>Position {container.position || index + 1}</h3>
                {container.status && (
                  <span class={`badge badge-small badge-status badge-${container.status}`}>
                    {container.status}
                  </span>
                )}
              </div>
              {container.species && (
                <p class="container-species">{container.species}</p>
              )}
              {container.recipe && (
                <p class="container-recipe">Recipe: {container.recipe}</p>
              )}
              {container.inoculation_date && (
                <p class="container-date">Inoculated: {new Date(container.inoculation_date).toLocaleDateString()}</p>
              )}
              {container.colonization_percentage !== undefined && (
                <div class="colonization-progress">
                  <div class="colonization-label">Colonization: {container.colonization_percentage}%</div>
                  <div class="progress-bar small">
                    <div class="progress-fill" style={`width: ${container.colonization_percentage}%`}></div>
                  </div>
                </div>
              )}
              {container.expected_harvest && (
                <p class="container-harvest">Harvest: {new Date(container.expected_harvest).toLocaleDateString()}</p>
              )}
              {container.notes && (
                <p class="container-notes">{container.notes.slice(0, 80)}...</p>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Recipes Used -->
    {usedRecipes.length > 0 && (
      <div class="section">
        <h2>Recipes in Use ({usedRecipes.length})</h2>
        <div class="recipe-list">
          {usedRecipes.map((recipe: any) => (
            <a href={`/recipes/${recipe.id}`} class="recipe-item">
              <span class="recipe-name">{recipe.name}</span>
              <span class="recipe-count">
              {usedRecipeIds.filter((id: number) => id === recipe.id).length} containers          </span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Current Species -->
    {speciesOnRack.length > 0 && (
      <div class="section">
        <h2>Current Species ({speciesOnRack.length})</h2>
        <div class="species-grid">
          {speciesOnRack.map((species: any) => (
            <a href={`/species/${species.species_id || species.id}`} class="species-card">
              <div class="species-info">
                <h3>{species.title || species.scientific_name}</h3>
                {species.scientific_name && species.title !== species.scientific_name && (
                  <p class="scientific-name">{species.scientific_name}</p>
                )}
              </div>
              {species.difficulty && (
                <span class={`badge badge-difficulty badge-${species.difficulty}`}>
                  {species.difficulty}
                </span>
              )}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Maintenance Section -->
    {(rack.maintenance_schedule || rack.last_maintenance || rack.next_maintenance) && (
      <div class="section">
        <h2>Maintenance</h2>
        <div class="maintenance-info">
          {rack.maintenance_schedule && (
            <div class="maintenance-schedule">
              <h3>Schedule</h3>
              <p>{rack.maintenance_schedule}</p>
            </div>
          )}
          <div class="maintenance-dates">
            {rack.last_maintenance && (
              <div class="maintenance-date">
                <span class="date-label">Last Maintenance:</span>
                <span class="date-value">{new Date(rack.last_maintenance).toLocaleDateString()}</span>
              </div>
            )}
            {rack.next_maintenance && (
              <div class="maintenance-date">
                <span class="date-label">Next Scheduled:</span>
                <span class="date-value next">{new Date(rack.next_maintenance).toLocaleDateString()}</span>
              </div>
            )}
          </div>
          {rack.maintenance_notes && (
            <div class="maintenance-notes">
              <h3>Maintenance Notes</h3>
              <p>{rack.maintenance_notes}</p>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- Related Projects -->
    {relatedProjects.length > 0 && (
      <div class="section">
        <h2>Related Projects ({relatedProjects.length})</h2>
        <div class="project-grid">
          {relatedProjects.map((project: any) => (
            <a href={`/projects/${project.id}`} class="project-card">
              <div class="project-info">
                <h3>{project.name}</h3>
                {project.description && (
                  <p class="project-desc">{project.description.slice(0, 100)}...</p>
                )}
              </div>
              {project.status && (
                <span class={`badge badge-status badge-${project.status}`}>
                  {project.status}
                </span>
              )}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Notes -->
    {rack.notes && (
      <div class="section">
        <h2>Notes</h2>
        <p>{rack.notes}</p>
      </div>
    )}

    <!-- Tags -->
    {rack.tags && rack.tags.length > 0 && (
      <div class="section">
        <h2>Tags</h2>
        <div class="tag-list">
          {rack.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
    )}

    <div class="actions">
      <a href="/racks" class="btn-secondary">← Back to Racks</a>
      <a href={`/racks/${rack.id}/edit`} class="btn-primary">Edit Rack</a>
      <button class="btn-action" onclick="window.print()">Print Details</button>
    </div>
  </div>

<script is:inline>
  // Filter buttons functionality
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    // NOTE: Corrected selector from '.sample-card' to '.container-card'
    const containerCards = document.querySelectorAll('.container-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        
        // Update active button
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter cards
        containerCards.forEach(card => {
          const cardStatus = card.dataset.status;
          if (filter === 'all' || cardStatus === filter) {
            card.style.display = 'flex'; // Use flex or block based on the layout
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  /* Custom properties for consistency, mapping to botanical-theme.css */
  :root {
    --color-ink: #3d3027; /* botanical-ink */
    --color-sepia: #8b7355; /* botanical-sepia */
    --color-sage: #87a878; /* botanical-sage */
    --color-moss: #5a6e4f; /* botanical-moss */
    --color-cream: #f8f5f0; /* botanical-cream */
    --color-paper: #faf8f3; /* botanical-paper */
    --color-dusty-rose: #c4a69d; /* botanical-dusty-rose */

    /* Mappings to generic variables used in the original Astro component */
    --color-bg: var(--color-paper);
    --color-bg-card: var(--color-cream);
    --color-bg-card-hover: var(--color-cream); 
    --color-border: var(--color-sepia);
    --color-text: var(--color-ink);
    --color-text-dim: var(--color-sepia);

    --sl-color-accent: var(--color-moss); /* For primary actions/highlights */
    --sl-color-accent-high: var(--color-dusty-rose); /* For warning/key dates */
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    font-family: 'EB Garamond', serif; /* Apply theme font */
    color: var(--color-text);
  }

  /* --- HEADER & TITLES --- */

  .rack-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--color-sepia);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .rack-header h1 {
    font-size: 2.5rem;
    margin: 0;
    flex: 1;
    color: var(--color-ink);
    font-family: 'Crimson Text', serif;
    font-weight: 700;
  }

  .header-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .section {
    background: var(--color-bg-card);
    border: 1px solid var(--color-sepia);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05); /* Subtle shadow */
  }

  .section h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-moss);
    font-family: 'Crimson Text', serif;
    border-bottom: 1px dotted var(--color-sepia);
    padding-bottom: 0.5rem;
  }
  
  /* --- BADGES --- */

  .badge {
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge-status.badge-occupied,
  .badge-status.badge-active {
    background: var(--color-moss);
    color: var(--color-paper);
  }

  .badge-status.badge-available,
  .badge-status.badge-empty {
    background: var(--color-dusty-rose);
    color: var(--color-ink);
  }
  
  .badge-status.badge-contaminated {
    background: #7f1d1d; /* Dark Red */
    color: white;
  }

  .badge-zone {
    background: var(--color-sepia);
    color: var(--color-paper);
  }

  .badge-type, .badge-difficulty {
    background: var(--color-sage);
    color: var(--color-ink);
  }

  /* --- STATS OVERVIEW --- */

  .stats-overview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-sepia);
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }

  .stat-card.warning {
    background: rgba(127, 29, 29, 0.1);
    border-color: #7f1d1d;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-moss); /* Primary theme color */
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--color-sepia);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .progress-bar {
    height: 0.5rem;
    background: var(--color-cream);
    border: 1px solid var(--color-sepia);
    border-radius: 0.25rem;
    margin-top: 0.75rem;
    overflow: hidden;
  }

  .progress-bar.small {
    height: 0.35rem;
    margin-top: 0.5rem;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-sage); /* Secondary theme color for fill */
    border-radius: 0.25rem;
    transition: width 0.3s ease;
  }

  /* --- ENVIRONMENTAL SECTION --- */
  
  .environmental-section {
    background: var(--color-paper);
    border: 1px dashed var(--color-sepia); /* Dashed border for a document feel */
  }

  .environment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.5rem;
  }

  .env-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-paper);
    border: none;
    border-bottom: 1px dotted var(--color-dusty-rose); /* Soft separator */
    padding: 0.75rem 0.5rem;
  }

  .env-icon {
    font-size: 1.8rem;
    opacity: 0.8;
  }

  .env-value {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .env-label {
    font-size: 0.75rem;
    color: var(--color-sepia);
    text-transform: uppercase;
  }

  .env-range {
    font-size: 0.875rem;
    color: var(--color-dusty-rose);
    margin-top: 0.25rem;
  }

  /* --- INFO GRID (Details) --- */
  
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .info-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-sepia);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .info-card h3 {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-sage);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .info-card p {
    font-size: 1.125rem;
    color: var(--color-ink);
    margin: 0;
  }

  /* --- CONTAINERS SECTION --- */

  .container-filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    background: var(--color-cream);
    border: 1px solid var(--color-sepia);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s;
    color: var(--color-ink);
  }

  .filter-btn:hover {
    background: var(--color-paper);
    border-color: var(--color-moss);
  }

  .filter-btn.active {
    background: var(--color-moss);
    color: white;
    border-color: var(--color-moss);
  }

  .container-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .container-card {
    background: var(--color-cream);
    border: 1px solid var(--color-sepia);
    border-radius: 0.5rem;
    padding: 1rem;
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .container-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.5rem;
    border-bottom: 1px dotted var(--color-dusty-rose);
  }

  .container-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .container-card.container-occupied {
    border-left: 4px solid var(--color-sage); /* Soft green indicator */
  }

  .container-card.container-available {
    border-left: 4px solid var(--color-dusty-rose);
    opacity: 0.85;
  }

  .container-card.container-contaminated {
    border-left: 4px solid #7f1d1d;
    background: rgba(127, 29, 29, 0.05);
  }

  .container-species, .container-recipe, .container-date, .container-notes {
    font-size: 0.875rem;
    color: var(--color-sepia);
    margin: 0;
  }

  .container-harvest {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-dusty-rose);
    margin: 0.5rem 0 0;
  }

  /* --- RECIPE LIST --- */

  .recipe-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--color-paper);
    border: 1px solid var(--color-sepia);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .recipe-item:hover {
    border-color: var(--color-moss);
    background: var(--color-cream);
    transform: translateX(2px);
  }

  .recipe-name {
    font-weight: 500;
    color: var(--color-ink);
  }

  .recipe-count {
    font-size: 0.875rem;
    color: var(--color-sepia);
  }
  
  /* --- SPECIES CARD --- */
  
  .species-card {
    display: flex;
    justify-content: space-between;
