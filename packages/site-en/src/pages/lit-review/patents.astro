---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Patents - Literature Review">
  <div style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
    <a href="/lit-review" style="display: inline-block; margin-bottom: 2rem; color: #87a878; text-decoration: none; font-weight: 600;">
      ← Back to Literature Review
    </a>
    
    <div style="background: var(--card-bg); border: 3px solid var(--border-color); padding: 2.5rem; border-radius: 16px;">
      <h1 style="font-size: 2.5rem; margin-bottom: 2rem;">Patents</h1>
      
      <div style="margin-bottom: 2rem;">
        <p style="font-size: 1.1rem; line-height: 1.8; color: var(--text-primary);">
          This section explores patents in the context of mycology and fungal research.
        </p>
      </div>

      <div style="background: rgba(135, 168, 120, 0.1); padding: 2rem; border-radius: 12px; border-left: 4px solid #87a878;">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: #5a6e4f;">📝 Content Coming Soon</h2>
        <p style="line-height: 1.6;">
          This literature review section is currently being populated with curated content, 
          references, and insights about patents in mycological research and applications.
        </p>
      </div>
    </div>
  </div>
</Layout>
