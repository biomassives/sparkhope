---
---

<div class="create-button-container">
  <button class="create-button" id="create-btn" aria-label="Create new entry">
    <span class="plus-icon">+</span>
  </button>
</div>

<!-- Creation Form Overlay -->
<div class="create-overlay" id="create-overlay">
  <div class="create-form-container">
    <button class="close-btn" id="close-create">✕</button>
    
    <h2 class="form-title">CREATE NEW ENTRY</h2>
    
    <div class="form-tabs">
      <button class="form-tab active" data-form="observation">📝 OBSERVATION</button>
      <button class="form-tab" data-form="specimen">🧫 SPECIMEN</button>
    </div>

    <!-- Observation Form -->
    <form class="creation-form" id="observation-form">
      <div class="form-group">
        <label>BATCH ID</label>
        <input type="text" name="batch_id" placeholder="BATCH-001" required />
      </div>

      <div class="form-group">
        <label>DATE</label>
        <input type="date" name="observation_date" required />
      </div>

      <div class="form-group">
        <label>VISUAL ASSESSMENT</label>
        <textarea name="visual_assessment" rows="4" placeholder="Describe what you see..." required></textarea>
      </div>

      <div class="form-group">
        <label>CONTAMINATION?</label>
        <select name="contamination">
          <option value="false">NO</option>
          <option value="true">YES</option>
        </select>
      </div>

      <div class="form-group">
        <label>NOTES</label>
        <textarea name="notes" rows="3" placeholder="Additional observations..."></textarea>
      </div>

      <button type="submit" class="submit-btn">CREATE OBSERVATION</button>
    </form>

    <!-- Specimen Form -->
    <form class="creation-form" id="specimen-form" style="display: none;">
      <div class="form-group">
        <label>SPECIMEN ID</label>
        <input type="text" name="id" placeholder="SPEC-001" required />
      </div>

      <div class="form-group">
        <label>FROM BATCH</label>
        <input type="text" name="batch_id" placeholder="BATCH-001" required />
      </div>

      <div class="form-group">
        <label>SAMPLE TYPE</label>
        <select name="sample_type" required>
          <option value="">Select type...</option>
          <option value="agar_culture">Agar Culture</option>
          <option value="liquid_culture">Liquid Culture</option>
          <option value="grain_spawn">Grain Spawn</option>
          <option value="fruiting_body">Fruiting Body</option>
        </select>
      </div>

      <div class="form-group">
        <label>STATUS</label>
        <select name="status">
          <option value="active">Active</option>
          <option value="ready">Ready</option>
          <option value="contaminated">Contaminated</option>
        </select>
      </div>

      <div class="form-group">
        <label>LOCATION</label>
        <input type="text" name="location_id" placeholder="RACK-A1" />
      </div>

      <div class="form-group">
        <label>NOTES</label>
        <textarea name="notes" rows="3" placeholder="Additional details..."></textarea>
      </div>

      <button type="submit" class="submit-btn">CREATE SPECIMEN</button>
    </form>

    <div class="api-status" id="api-status"></div>
  </div>
</div>

<script>
  const createBtn = document.getElementById('create-btn');
  const overlay = document.getElementById('create-overlay');
  const closeBtn = document.getElementById('close-create');
  const formTabs = document.querySelectorAll('.form-tab');
  const observationForm = document.getElementById('observation-form');
  const specimenForm = document.getElementById('specimen-form');
  const apiStatus = document.getElementById('api-status');

  // API endpoint - will be configured via environment variable
  const API_ENDPOINT = import.meta.env.PUBLIC_API_ENDPOINT || '/api';

  // Open overlay
  createBtn?.addEventListener('click', () => {
    overlay?.classList.add('active');
  });

  // Close overlay
  closeBtn?.addEventListener('click', () => {
    overlay?.classList.remove('active');
  });

  // Tab switching
  formTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const formType = tab.getAttribute('data-form');
      
      formTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      
      if (formType === 'observation') {
        observationForm!.style.display = 'block';
        specimenForm!.style.display = 'none';
      } else {
        observationForm!.style.display = 'none';
        specimenForm!.style.display = 'block';
      }
    });
  });

  // Form submission - Observation
  observationForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);
    const data = Object.fromEntries(formData.entries());
    
    try {
      apiStatus!.textContent = 'CREATING...';
      apiStatus!.className = 'api-status info';
      
      const response = await fetch(`${API_ENDPOINT}/observations`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      if (response.ok) {
        apiStatus!.textContent = 'OBSERVATION CREATED! ✓';
        apiStatus!.className = 'api-status success';
        (e.target as HTMLFormElement).reset();
        setTimeout(() => {
          overlay?.classList.remove('active');
          window.location.reload();
        }, 1500);
      } else {
        throw new Error('Failed to create');
      }
    } catch (error) {
      apiStatus!.textContent = 'ERROR: Could not create observation';
      apiStatus!.className = 'api-status error';
    }
  });

  // Form submission - Specimen
  specimenForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);
    const data = Object.fromEntries(formData.entries());
    
    try {
      apiStatus!.textContent = 'CREATING...';
      apiStatus!.className = 'api-status info';
      
      const response = await fetch(`${API_ENDPOINT}/samples`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      if (response.ok) {
        apiStatus!.textContent = 'SPECIMEN CREATED! ✓';
        apiStatus!.className = 'api-status success';
        (e.target as HTMLFormElement).reset();
        setTimeout(() => {
          overlay?.classList.remove('active');
          window.location.reload();
        }, 1500);
      } else {
        throw new Error('Failed to create');
      }
    } catch (error) {
      apiStatus!.textContent = 'ERROR: Could not create specimen';
      apiStatus!.className = 'api-status error';
    }
  });
</script>

<style>
  .create-button-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 9990;
  }

  .create-button {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #00ff00, #00cc00);
    border: 4px solid #00ff00;
    box-shadow: 
      0 8px 30px rgba(0, 255, 0, 0.5),
      inset 0 -3px 10px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: pulse-green 2s ease-in-out infinite;
  }

  @keyframes pulse-green {
    0%, 100% {
      box-shadow: 0 8px 30px rgba(0, 255, 0, 0.5);
    }
    50% {
      box-shadow: 0 8px 40px rgba(0, 255, 0, 0.8), 0 0 60px rgba(0, 255, 0, 0.4);
    }
  }

  .create-button:hover {
    transform: scale(1.1) rotate(90deg);
    box-shadow: 0 12px 40px rgba(0, 255, 0, 0.7);
  }

  .create-button:active {
    transform: scale(0.95) rotate(90deg);
  }

  .plus-icon {
    font-family: 'Press Start 2P', monospace;
    font-size: 3rem;
    color: #000;
    line-height: 1;
  }

  /* Overlay */
  .create-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.95);
    z-index: 9995;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .create-overlay.active {
    display: flex;
  }

  .create-form-container {
    background: #0a0a0a;
    border: 4px solid #00ff00;
    border-radius: 12px;
    padding: 2rem;
    max-width: 600px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 
      0 0 40px rgba(0, 255, 0, 0.5),
      inset 0 0 20px rgba(0, 255, 0, 0.1);
    position: relative;
  }

  .close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 40px;
    height: 40px;
    border: 3px solid #ff0000;
    background: #000;
    color: #ff0000;
    font-size: 1.5rem;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Press Start 2P', monospace;
  }

  .close-btn:hover {
    background: #ff0000;
    color: #000;
    transform: rotate(90deg);
  }

  .form-title {
    font-family: 'Press Start 2P', monospace;
    font-size: 1.2rem;
    color: #00ff00;
    text-align: center;
    margin-bottom: 1.5rem;
    text-shadow: 0 0 15px #00ff00;
  }

  .form-tabs {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .form-tab {
    flex: 1;
    font-family: 'Press Start 2P', monospace;
    font-size: 0.6rem;
    padding: 0.75rem;
    border: 2px solid #00ff00;
    background: #000;
    color: #00ff00;
    cursor: pointer;
    transition: all 0.2s;
  }

  .form-tab:hover {
    background: rgba(0, 255, 0, 0.1);
  }

  .form-tab.active {
    background: #00ff00;
    color: #000;
    box-shadow: 0 0 15px rgba(0, 255, 0, 0.5);
  }

  .creation-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.6rem;
    color: #00ff00;
    text-shadow: 0 0 8px #00ff00;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: 'VT323', monospace;
    font-size: 1.2rem;
    padding: 0.75rem;
    background: #000;
    border: 2px solid #00ff00;
    color: #00ff00;
    border-radius: 4px;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    box-shadow: 0 0 15px rgba(0, 255, 0, 0.5);
  }

  .submit-btn {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.7rem;
    padding: 1rem;
    background: #00ff00;
    border: 3px solid #00ff00;
    color: #000;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 1rem;
  }

  .submit-btn:hover {
    box-shadow: 0 0 20px rgba(0, 255, 0, 0.7);
    transform: scale(1.05);
  }

  .api-status {
    font-family: 'VT323', monospace;
    font-size: 1.1rem;
    text-align: center;
    padding: 1rem;
    margin-top: 1rem;
    border-radius: 4px;
  }

  .api-status.info {
    background: rgba(0, 255, 255, 0.1);
    border: 2px solid #00ffff;
    color: #00ffff;
  }

  .api-status.success {
    background: rgba(0, 255, 0, 0.1);
    border: 2px solid #00ff00;
    color: #00ff00;
  }

  .api-status.error {
    background: rgba(255, 0, 0, 0.1);
    border: 2px solid #ff0000;
    color: #ff0000;
  }

  @media (max-width: 768px) {
    .create-button {
      width: 60px;
      height: 60px;
    }

    .plus-icon {
      font-size: 2rem;
    }

    .create-form-container {
      padding: 1.5rem;
    }

    .form-title {
      font-size: 0.9rem;
    }
  }
</style>
