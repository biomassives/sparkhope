  { href: '/lit-review/tech-infusion', label: 'Tech Infusion', icon: 'tech', color: '#ff2200' },
  { href: '/lit-review/basidiomycetes-lc', label: 'Basidiomycetes LC', icon: 'basidio', color: '#ff00aa' },
  { href: '/lit-review/other-groups-lc', label: 'Other Groups LC', icon: 'groups', color: '#cc00ff' },
