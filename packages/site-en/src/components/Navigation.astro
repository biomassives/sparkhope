---

<!-- CRITICAL: Define switchNav FIRST -->
<script is:inline>
  window.switchNav = function(targetNav) {
    console.log('🎮 SWITCH NAV:', targetNav);
    document.querySelectorAll('.nav-toggle').forEach(btn => {
      btn.getAttribute('data-nav') === targetNav ? 
        btn.setAttribute('data-active', 'true') : 
        btn.removeAttribute('data-active');
    });
    document.querySelectorAll('[data-nav-panel]').forEach(panel => {
      panel.style.display = panel.getAttribute('data-nav-panel') === targetNav ? 'flex' : 'none';
    });
    if (window.playBlip) window.playBlip();
  };
</script>

<!-- Ships Container -->
<div class="ships-background">
  <div class="ufo-mothership" id="ufo">
    <svg viewBox="0 0 32 16" xmlns="http://www.w3.org/2000/svg" style="image-rendering: pixelated;">
      <rect x="8" y="4" width="16" height="2" fill="currentColor"/>
      <rect x="6" y="6" width="20" height="2" fill="currentColor"/>
      <rect x="4" y="8" width="24" height="2" fill="currentColor"/>
      <rect x="10" y="10" width="4" height="2" fill="currentColor"/>
      <rect x="18" y="10" width="4" height="2" fill="currentColor"/>
      <rect x="14" y="2" width="4" height="2" fill="currentColor"/>
    </svg>
    <div class="ufo-score">??? PTS</div>
  </div>

  <div class="small-ship ship-cyan" id="small-ship-1">
    <svg viewBox="0 0 20 10" xmlns="http://www.w3.org/2000/svg" style="image-rendering: pixelated;">
      <rect x="6" y="3" width="8" height="2" fill="#00ffff"/>
      <rect x="4" y="5" width="12" height="2" fill="#00ffff"/>
      <rect x="8" y="1" width="4" height="2" fill="#00ffff"/>
      <rect x="6" y="7" width="2" height="1" fill="#ffff00"/>
      <rect x="12" y="7" width="2" height="1" fill="#ffff00"/>
    </svg>
  </div>

  <div class="small-ship ship-magenta" id="small-ship-2">
    <svg viewBox="0 0 20 10" xmlns="http://www.w3.org/2000/svg" style="image-rendering: pixelated;">
      <rect x="6" y="3" width="8" height="2" fill="#ff00ff"/>
      <rect x="4" y="5" width="12" height="2" fill="#ff00ff"/>
      <rect x="8" y="1" width="4" height="2" fill="#ff00ff"/>
      <rect x="6" y="7" width="2" height="1" fill="#ffff00"/>
      <rect x="12" y="7" width="2" height="1" fill="#ffff00"/>
    </svg>
    <div class="banner-container">
      <div class="banner-pole"></div>
      <div class="banner-text" id="banner-text">LOADING...</div>
    </div>
  </div>
</div>

<!-- COMPACT Navigation Wrapper -->
<div class="nav-wrapper retro-arcade-compact" data-initial-nav={activeNav}>
  <div class="scanlines"></div>
  
  <!-- Compact Toggle Buttons -->
  <div class="nav-toggle-container-compact">
    <button class="nav-toggle pixel-btn-compact" data-nav="culture" data-active={activeNav === 'culture' ? 'true' : undefined} onclick="window.switchNav('culture')">
      <span class="pixel-text">👾 CULTURE</span>
    </button>
    <button class="nav-toggle pixel-btn-compact" data-nav="labops" data-active={activeNav === 'labops' ? 'true' : undefined} onclick="window.switchNav('labops')">
      <span class="pixel-text">🔬 LAB OPS</span>
    </button>
    <button class="nav-toggle pixel-btn-compact" data-nav="lit" data-active={activeNav === 'lit' ? 'true' : undefined} onclick="window.switchNav('lit')">
      <span class="pixel-text">🔥 LIT REV</span>
    </button>
  </div>

  <!-- Compact Second Tier -->
  <nav class="myco-nav arcade-grid-compact" data-nav-panel="culture" style={activeNav !== 'culture' ? 'display: none;' : ''}>
    {cultureItems.map(item => (
      <a href={item.href} class={`nav-panel pixel-panel ${currentPath.startsWith(item.href) ? 'active' : ''}`} style={`--item-color: ${item.color}`} title={item.label} data-nav-item>
        <div class="icon-wrapper pixel-icon" set:html={svgIcons[item.icon]} />
        <div class="label pixel-label">{item.label}</div>
      </a>
    ))}
  </nav>

  <nav class="myco-nav arcade-grid-compact" data-nav-panel="labops" style={activeNav !== 'labops' ? 'display: none;' : ''}>
    {labOpsItems.map(item => (
      <a href={item.href} class={`nav-panel pixel-panel ${currentPath.startsWith(item.href) ? 'active' : ''}`} style={`--item-color: ${item.color}`} title={item.label} data-nav-item>
        <div class="icon-wrapper pixel-icon" set:html={svgIcons[item.icon]} />
        <div class="label pixel-label">{item.label}</div>
      </a>
    ))}
  </nav>

  <nav class="myco-nav arcade-grid-compact lit-review-grid" data-nav-panel="lit" style={activeNav !== 'lit' ? 'display: none;' : ''}>
    {litReviewItems.map(item => (
      <a href={item.href} class={`nav-panel pixel-panel ${currentPath.startsWith(item.href) ? 'active' : ''}`} style={`--item-color: ${item.color}`} title={item.label} data-nav-item>
        <div class="icon-wrapper pixel-icon" set:html={svgIcons[item.icon]} />
        <div class="label pixel-label">{item.label}</div>
      </a>
    ))}
  </nav>
</div>

<script define:vars={{ bannerMessages }}>
  const audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
  
  function playBeep() {
    const osc = audioContext.createOscillator();
    const gain = audioContext.createGain();
    osc.connect(gain);
    gain.connect(audioContext.destination);
    osc.type = 'square';
    osc.frequency.setValueAtTime(880, audioContext.currentTime);
    gain.gain.setValueAtTime(0.1, audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.08);
    osc.start(audioContext.currentTime);
    osc.stop(audioContext.currentTime + 0.08);
  }
  
  window.playBlip = function() {
    const osc = audioContext.createOscillator();
    const gain = audioContext.createGain();
    osc.connect(gain);
    gain.connect(audioContext.destination);
    osc.type = 'square';
    osc.frequency.setValueAtTime(440, audioContext.currentTime);
    osc.frequency.exponentialRampToValueAtTime(220, audioContext.currentTime + 0.05);
    gain.gain.setValueAtTime(0.12, audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.05);
    osc.start(audioContext.currentTime);
    osc.stop(audioContext.currentTime + 0.05);
  };

  function playSpaceInvadersSound() {
    const notes = [220, 196, 175, 165];
    notes.forEach((freq, i) => {
      setTimeout(() => {
        const osc = audioContext.createOscillator();
        const gain = audioContext.createGain();
        osc.connect(gain);
        gain.connect(audioContext.destination);
        osc.type = 'square';
        osc.frequency.setValueAtTime(freq, audioContext.currentTime);
        gain.gain.setValueAtTime(0.15, audioContext.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
        osc.start(audioContext.currentTime);
        osc.stop(audioContext.currentTime + 0.3);
      }, i * 300);
    });
  }

  function playExplosion() {
    const osc = audioContext.createOscillator();
    const gain = audioContext.createGain();
    osc.connect(gain);
    gain.connect(audioContext.destination);
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(800, audioContext.currentTime);
    osc.frequency.exponentialRampToValueAtTime(50, audioContext.currentTime + 0.3);
    gain.gain.setValueAtTime(0.2, audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
    osc.start(audioContext.currentTime);
    osc.stop(audioContext.currentTime + 0.3);
  }

  function playWhoosh() {
    const osc = audioContext.createOscillator();
    const gain = audioContext.createGain();
    osc.connect(gain);
    gain.connect(audioContext.destination);
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(600, audioContext.currentTime);
    osc.frequency.exponentialRampToValueAtTime(200, audioContext.currentTime + 0.25);
    gain.gain.setValueAtTime(0.1, audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.25);
    osc.start(audioContext.currentTime);
    osc.stop(audioContext.currentTime + 0.25);
  }

  document.querySelectorAll('[data-nav-item]').forEach(item => {
    item.addEventListener('mouseenter', () => playBeep());
  });

  const ufo = document.getElementById('ufo');
  const smallShip1 = document.getElementById('small-ship-1');
  const smallShip2 = document.getElementById('small-ship-2');
  const bannerText = document.getElementById('banner-text');
  let ufoClicked = false;
  
  function launchUFO() {
    if (!ufo) return;
    const scores = [50, 100, 150, 200, 300];
    const score = scores[Math.floor(Math.random() * scores.length)];
    const scoreDisplay = ufo.querySelector('.ufo-score');
    if (scoreDisplay) scoreDisplay.textContent = `${score} PTS`;
    ufoClicked = false;
    ufo.classList.remove('hit', 'flying');
    ufo.style.top = `${10 + Math.random() * 20}%`;
    ufo.style.left = '110%';
    ufo.style.display = 'block';
    playSpaceInvadersSound();
    setTimeout(() => ufo.classList.add('flying'), 50);
    setTimeout(() => { if (!ufoClicked) ufo.style.display = 'none'; }, 8000);
  }
  
  function launchSmallShip1() {
    if (!smallShip1) return;
    smallShip1.style.top = `${5 + Math.random() * 15}%`;
    smallShip1.style.left = '-60px';
    smallShip1.style.display = 'block';
    playWhoosh();
    setTimeout(() => smallShip1.classList.add('flying'), 50);
    setTimeout(() => {
      smallShip1.style.display = 'none';
      smallShip1.classList.remove('flying');
    }, 4000);
  }

  function launchSmallShip2() {
    if (!smallShip2 || !bannerText) return;
    bannerText.textContent = bannerMessages[Math.floor(Math.random() * bannerMessages.length)];
    smallShip2.style.top = `${60 + Math.random() * 20}%`;
    smallShip2.style.left = '110%';
    smallShip2.style.display = 'block';
    playWhoosh();
    setTimeout(() => smallShip2.classList.add('flying'), 50);
    setTimeout(() => {
      smallShip2.style.display = 'none';
      smallShip2.classList.remove('flying');
    }, 15000);
  }
  
  ufo?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (ufoClicked) return;
    ufoClicked = true;
    ufo.classList.remove('flying');
    ufo.classList.add('hit');
    playExplosion();
    const scoreDisplay = ufo.querySelector('.ufo-score');
    if (scoreDisplay) scoreDisplay.style.display = 'block';
    setTimeout(() => {
      ufo.style.display = 'none';
      if (scoreDisplay) scoreDisplay.style.display = 'none';
    }, 2000);
  });
  
  function scheduleNextUFO() { setTimeout(() => { launchUFO(); scheduleNextUFO(); }, 15000 + Math.random() * 15000); }
  function scheduleNextSmallShip1() { setTimeout(() => { launchSmallShip1(); scheduleNextSmallShip1(); }, 10000 + Math.random() * 15000); }
  function scheduleNextSmallShip2() { setTimeout(() => { launchSmallShip2(); scheduleNextSmallShip2(); }, 12000 + Math.random() * 20000); }
  
  setTimeout(() => { launchUFO(); scheduleNextUFO(); }, 3000);
  setTimeout(() => { launchSmallShip1(); scheduleNextSmallShip1(); }, 5000);
  setTimeout(() => { launchSmallShip2(); scheduleNextSmallShip2(); }, 8000);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

  .ships-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
