---
import '../styles/poster-theme.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'SparkHope - Transforma vidas hoy' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | SparkHope</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <slot />
</body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
    font-family: var(--font-poster-body);
    background: var(--poster-cream);
    color: var(--poster-midnight);
  }
  
  :global(*) {
    box-sizing: border-box;
  }
</style>
