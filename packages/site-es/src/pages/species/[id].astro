---
import Layout from '../../layouts/Layout.astro';
import { getAllSpecies, getSpeciesById, getSamplesBySpecies, getBatchesBySpecies, getAllSamples } from '../../utils/loadData';

export function getStaticPaths() {
  const species = getAllSpecies();
  return species.map((sp: any) => ({
    params: { id: sp.id }
  }));
}

const { id } = Astro.params;
const species = getSpeciesById(id);

if (!species) {
  return Astro.redirect('/species');
}

const allSamples = getAllSamples();
const samples = getSamplesBySpecies(allSamples, id);
const batches = getBatchesBySpecies(id);
---

<Layout title={`${species.common_name || species.scientific_name} - SparkHope MycoLab`}>
  <div style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
    <a href="/species" style="display: inline-block; margin-bottom: 2rem; color: #87a878; text-decoration: none; font-weight: 600;">
      ← Volver a Especies
    </a>
    
    <div style="background: white; border: 3px solid #8b7355; padding: 2rem; border-radius: 8px;">
      <div style="margin-bottom: 2rem;">
        <h1 style="font-size: 2rem; margin-bottom: 0.5rem;">{species.common_name}</h1>
        <p style="font-size: 1.25rem; font-style: italic; color: #666; margin-bottom: 1rem;">
          {species.scientific_name}
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
        <div>
          <h2 style="font-size: 1.25rem; margin-bottom: 1rem; color: #5a6e4f;">Información</h2>
          <dl style="display: grid; grid-template-columns: auto 1fr; gap: 0.75rem 1rem;">
            <dt style="font-weight: 600; color: #666;">Nombre Común:</dt>
            <dd>{species.common_name || '—'}</dd>
            
            <dt style="font-weight: 600; color: #666;">Nombre Científico:</dt>
            <dd><em>{species.scientific_name}</em></dd>
            
            {species.family && (
              <>
                <dt style="font-weight: 600; color: #666;">Familia:</dt>
                <dd>{species.family}</dd>
              </>
            )}
          </dl>
        </div>

        <div>
          <h2 style="font-size: 1.25rem; margin-bottom: 1rem; color: #5a6e4f;">Estadísticas</h2>
          <dl style="display: grid; grid-template-columns: auto 1fr; gap: 0.75rem 1rem;">
            <dt style="font-weight: 600; color: #666;">Especímenes:</dt>
            <dd>{samples.length}</dd>
            
            <dt style="font-weight: 600; color: #666;">Lotes:</dt>
            <dd>{batches.length}</dd>
          </dl>
        </div>
      </div>

      {species.description && (
        <div style="margin-top: 2rem; padding-top: 2rem; border-top: 2px solid #ddd;">
          <h2 style="font-size: 1.25rem; margin-bottom: 1rem; color: #5a6e4f;">Descripción</h2>
          <p style="line-height: 1.6; color: #444;">{species.description}</p>
        </div>
      )}

      {samples.length > 0 && (
        <div style="margin-top: 2rem; padding-top: 2rem; border-top: 2px solid #ddd;">
          <h2 style="font-size: 1.25rem; margin-bottom: 1rem; color: #5a6e4f;">
            Specimens ({samples.length})
          </h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
            {samples.map((sample: any) => (
              <a href={`/samples/${sample.id}`} style="text-decoration: none; color: inherit;">
                <div style="background: #f8f5f0; border: 2px solid #8b7355; padding: 1rem; border-radius: 4px; transition: all 0.2s;">
                  <span style="font-weight: 600; font-family: monospace;">{sample.id}</span>
                  <br/>
                  <span style="font-size: 0.85rem; color: #666;">{sample.status}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {batches.length > 0 && (
        <div style="margin-top: 2rem; padding-top: 2rem; border-top: 2px solid #ddd;">
          <h2 style="font-size: 1.25rem; margin-bottom: 1rem; color: #5a6e4f;">
            Batches ({batches.length})
          </h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
            {batches.map((batch: any) => (
              <a href={`/batches/${batch.id}`} style="text-decoration: none; color: inherit;">
                <div style="background: #f8f5f0; border: 2px solid #8b7355; padding: 1rem; border-radius: 4px; transition: all 0.2s;">
                  <span style="font-weight: 600; font-family: monospace;">{batch.id}</span>
                  <br/>
                  <span style="font-size: 0.85rem; color: #666;">{batch.status || 'active'}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>
