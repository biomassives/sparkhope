---
import Layout from '../../layouts/Layout.astro';
import { getAllObservations } from '../../utils/loadData';

const observations = getAllObservations();
const recentObs = observations.slice(0, 50);
---

<Layout title="Observations - SparkHope MycoLab">
  <div style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
    <h1 style="font-size: 2.5rem; margin-bottom: 2rem;">📝 Observaciones de Laboratorio</h1>
    
    <div style="background: white; border: 2px solid #8b7355; padding: 1.5rem; margin-bottom: 2rem; text-align: center;">
      <div style="font-size: 2rem; font-weight: 700; color: #87a878;">{observations.length}</div>
      <div style="font-size: 0.9rem; color: #666;">Observaciones Totales</div>
    </div>

    <div style="display: grid; gap: 1rem;">
      {recentObs.map((obs: any) => (
        <div style="background: white; border: 2px solid #8b7355; border-left: 4px solid #87a878; padding: 1.5rem; border-radius: 8px;">
          <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
            <h3 style="font-size: 1.1rem; color: #5a6e4f; font-family: monospace;">
              {obs.batch_id || obs.sample_id || 'General'}
            </h3>
            {obs.observation_date && (
              <span style="font-size: 0.85rem; color: #999;">
                {new Date(obs.observation_date).toLocaleDateString()}
              </span>
            )}
          </div>
          <p style="color: #666; line-height: 1.6;">{obs.visual_assessment || obs.notes || 'No notes'}</p>
          {obs.contamination && (
            <span style="display: inline-block; margin-top: 0.5rem; padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; background: #fee2e2; color: #7f1d1d;">
              ⚠️ Contaminación
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</Layout>
