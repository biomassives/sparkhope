---
// src/pages/ingredients/[id].astro - FIXED
import Layout from '../../layouts/Layout.astro';
import { getAllSamples, getSampleById, getAllProjects, getProjectById, getAllSpecies, getSpeciesById, getAllBatches, getBatchById, getAllRecipes, getRecipeById, getAllObservations, getObservationById, getAllRacks, getRackById, getAllIngredients, getIngredientById } from '../../utils/loadData';

const { id } = Astro.params;

const allIngredients = getAllIngredients();

// Find the specific ingredient
const ingredient = allIngredients.find((i: any) => 
  i.id === id
);

if (!ingredient) {
  return Astro.redirect('/404');
}

// Export getStaticPaths for static site generation
export async function getStaticPaths() {
  const ingredients = getAllIngredients();
  
  return ingredients.map((ingredient: any) => ({
    params: { id: ingredient.id },
  }));
}

// Find recipes and batches that use this ingredient
const allRecipes = getAllRecipes();
const allBatches = getAllBatches();

// Recipes have nested ingredient objects with id matching
const recipesUsingThis = allRecipes.filter((r: any) => 
  r.ingredients && r.ingredients.some((ing: any) => ing.id === ingredient.id)
);

const batchesUsingThis = allBatches.filter((b: any) => 
  b.ingredients && b.ingredients.includes(ingredient.id)
);
---

<Layout title={`${ingredient.name || 'Ingredient'} - SparkHope`}>
  <div class="container">
    <div class="ingredient-header">
      <div class="header-content">
        <h1>{ingredient.name || 'Untitled Ingredient'}</h1>
        {ingredient.category && (
          <span class={`badge badge-${ingredient.category}`}>
            {ingredient.category === 'base' && '🧪 Base'}
            {ingredient.category === 'additive' && '➕ Additive'}
            {ingredient.category === 'local' && '🏠 Local'}
            {ingredient.category === 'commercial' && '🏪 Commercial'}
            {ingredient.category === 'foraged' && '🌲 Foraged'}
            {ingredient.category === 'waste_stream' && '♻️ Waste Stream'}
            {ingredient.category === 'other' && '📦 Other'}
          </span>
        )}
      </div>
    </div>

    {ingredient.description && (
      <div class="section">
        <h2>Description</h2>
        <p>{ingredient.description}</p>
      </div>
    )}

    {ingredient.storage_notes && (
      <div class="section storage-section">
        <h2>📦 Storage Information</h2>
        <p>{ingredient.storage_notes}</p>
      </div>
    )}

    <div class="usage-stats">
      <div class="stat-card">
        <span class="stat-number">{recipesUsingThis.length}</span>
        <span class="stat-label">Recipes</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">{batchesUsingThis.length}</span>
        <span class="stat-label">Batches</span>
      </div>
    </div>

    {recipesUsingThis.length > 0 && (
      <div class="section">
        <h2>Used in Recipes ({recipesUsingThis.length})</h2>
        <div class="items-grid">
          {recipesUsingThis.map((recipe: any) => (
            <a href={`/recipes/${recipe.id}`} class="item-card">
              <div class="item-header">
                <h3>{recipe.name}</h3>
                {recipe.type && (
                  <span class="item-badge">{recipe.type}</span>
                )}
              </div>
              {recipe.description && (
                <p>{recipe.description.substring(0, 100)}{recipe.description.length > 100 ? '...' : ''}</p>
              )}
            </a>
          ))}
        </div>
      </div>
    )}

    {batchesUsingThis.length > 0 && (
      <div class="section">
        <h2>Used in Batches ({batchesUsingThis.length})</h2>
        <div class="items-grid">
          {batchesUsingThis.map((batch: any) => (
            <a href={`/batches/${batch.batch_id || batch.id}`} class="item-card">
              <div class="item-header">
                <h3>{batch.title}</h3>
                {batch.status && (
                  <span class={`badge badge-${batch.status}`}>
                    {batch.status}
                  </span>
                )}
              </div>
              {batch.description && (
                <p>{batch.description.substring(0, 100)}{batch.description.length > 100 ? '...' : ''}</p>
              )}
            </a>
          ))}
        </div>
      </div>
    )}

    {recipesUsingThis.length === 0 && batchesUsingThis.length === 0 && (
      <div class="empty-usage">
        <p>This ingredient is not currently used in any recipes or batches.</p>
      </div>
    )}

    <div class="actions">
      <a href="/ingredients" class="btn-secondary">← Back to Ingredients</a>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .ingredient-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .ingredient-header h1 {
    font-size: 2.5rem;
    margin: 0;
    flex: 1;
  }

  .badge {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .badge-base {
    background: #1e3a8a;
    color: #dbeafe;
  }

  .badge-additive {
    background: #78350f;
    color: #fef3c7;
  }

  .badge-local {
    background: #065f46;
    color: #d1fae5;
  }

  .badge-commercial {
    background: #1e3a8a;
    color: #dbeafe;
  }

  .badge-foraged {
    background: #78350f;
    color: #fef3c7;
  }

  .badge-waste_stream {
    background: #065f46;
    color: #d1fae5;
  }

  .badge-other {
    background: var(--color-bg-card-hover);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .badge-active {
    background: #065f46;
    color: #d1fae5;
  }

  .badge-contaminated {
    background: #7f1d1d;
    color: #fee2e2;
  }

  .badge-completed {
    background: #1e3a8a;
    color: #dbeafe;
  }

  .badge-harvested {
    background: #78350f;
    color: #fef3c7;
  }

  .section {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .section h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .section p {
    color: var(--color-text-dim);
    line-height: 1.6;
    margin: 0;
  }

  .storage-section {
    border-left: 4px solid var(--sl-color-accent);
  }

  .usage-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .stat-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.2s;
  }

  .stat-card:hover {
    background: var(--color-bg-card-hover);
    transform: translateY(-2px);
  }

  .stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--sl-color-accent-high);
    line-height: 1;
  }

  .stat-label {
    display: block;
    color: var(--color-text-dim);
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }

  .items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .item-card {
    background: var(--color-bg-card-hover);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .item-card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .item-card h3 {
    font-size: 1rem;
    margin: 0;
    color: var(--color-text);
    flex: 1;
  }

  .item-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  .item-card p {
    font-size: 0.875rem;
    color: var(--color-text-dim);
    margin: 0;
    line-height: 1.5;
  }

  .empty-usage {
    background: var(--color-bg-card);
    border: 2px dashed var(--color-border);
    border-radius: 0.75rem;
    padding: 3rem;
    text-align: center;
  }

  .empty-usage p {
    color: var(--color-text-dim);
    font-size: 1.125rem;
  }

  .actions {
    margin-top: 2rem;
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-bg-card);
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--sl-color-accent);
  }

  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      align-items: flex-start;
    }

    .ingredient-header h1 {
      font-size: 2rem;
    }

    .items-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
