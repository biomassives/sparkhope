---
// Define all the necessary props to make the component dynamic
const { 
    href, 
    icon, 
    count, 
    name, 
    latin, 
    stats, // array of strings, e.g., ["Ready: 10", "Growing: 5"]
    binary 
} = Astro.props;
---

<a href={href} class="collection-card">
    <div class="collection-visual">
        <div class="visual-icon">{icon}</div>
        <div class="visual-count">{count}</div>
    </div>
    <div class="collection-info">
        <h3 class="collection-name">{name}</h3>
        <p class="collection-latin">{latin}</p>
        <div class="collection-quick-stats">
            {stats.map((stat: string) => (
                <span>{stat}</span>
            ))}
        </div>
    </div>
    <div class="collection-binary">{binary}</div>
</a>

<style>
    /* Hybrid Theme Variables (Import these from a global CSS file or re-define if necessary) */
    /* Assuming botanical-sepia, botanical-sage, etc., are available globally or imported in Layout.astro */

    .collection-card {
        background: white;
        border: 3px solid var(--botanical-sepia, #8b7355); /* Use fallback variables */
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .collection-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15);
        border-color: var(--botanical-sage, #87a878);
    }

    .collection-visual {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1rem;
        border-bottom: 2px solid rgba(139, 115, 85, 0.2);
    }

    .visual-icon {
        font-size: 3rem;
    }

    .visual-count {
        font-family: 'VT323', monospace;
        font-size: 3rem;
        color: var(--botanical-sage, #87a878);
    }

    .collection-info {
        flex: 1;
    }

    .collection-name {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .collection-latin {
        font-size: 0.9rem;
        font-style: italic;
        color: var(--botanical-sepia, #8b7355);
        margin-bottom: 0.75rem;
    }

    .collection-quick-stats {
        font-size: 0.85rem;
        color: var(--botanical-sepia, #8b7355);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .collection-binary {
        font-family: 'VT323', monospace;
        font-size: 0.85rem;
        color: var(--pixel-green, #00ff41);
        text-align: center;
        padding-top: 0.75rem;
        border-top: 1px dashed var(--botanical-sepia, #8b7355);
    }
</style>
