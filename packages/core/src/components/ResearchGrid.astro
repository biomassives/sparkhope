---
// Defines props: the array of projects and localized text for display
const { 
    projects, 
    title, 
    labelManager, 
    labelPriority, 
    labelProgress, 
    binaryText 
} = Astro.props;

const activeProjects = projects.filter((p: any) => p.status === 'Active').slice(0, 3);
---

{activeProjects.length > 0 && (
    <section class="research-section">
        <h2 class="section-title">
            <span class="title-ornament">❦</span>
            <span class="title-text">{title}</span>
            <span class="title-ornament">❦</span>
        </h2>

        <div class="research-grid">
            {activeProjects.map((project: any) => (
                <a href={`/projects/${project.id}`} class="research-card">
                    <div class="research-header">
                        <span class="research-type">{project.type}</span>
                        {project.priority === 'High' && (
                            <span class="research-priority">{labelPriority}</span>
                        )}
                    </div>

                    <h3 class="research-title">{project.name}</h3>

                    <div class="research-manager">
                        <span class="label">{labelManager}</span> {project.manager || 'Unassigned'}
                    </div>

                    <div class="research-progress">
                        <div class="progress-label">{labelProgress}: {project.progress_percentage}%</div>
                        <div class="progress-bar">
                            <div class="progress-fill" style={`width: ${project.progress_percentage}%`}></div>
                        </div>
                    </div>

                    <div class="research-binary">{binaryText}</div>
                </a>
            ))}
        </div>
    </section>
)}

<style>
    /* Styling for the research section moved from index.astro */
    .research-section {
        max-width: 1400px;
        margin: 0 auto;
        padding: 3rem 2rem;
    }

    .section-title {
        text-align: center;
        margin-bottom: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .title-ornament {
        font-size: 1.5rem;
        color: var(--botanical-sepia, #8b7355);
    }

    .title-text {
        font-size: 2rem;
        font-weight: 600;
        color: var(--botanical-ink, #3d3027);
        letter-spacing: 0.1em;
        font-variant: small-caps;
    }

    .research-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
    }

    .research-card {
        background: white;
        border: 3px double var(--botanical-sage, #87a878);
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        box-shadow: 6px 6px 16px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }

    .research-card:hover {
        transform: translateY(-4px);
        box-shadow: 8px 8px 20px rgba(0,0,0,0.15);
    }

    .research-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(139, 115, 85, 0.3);
    }

    .research-type {
        font-size: 0.85rem;
        font-weight: 600;
        font-variant: small-caps;
        color: var(--botanical-sepia, #8b7355);
    }

    .research-priority {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--botanical-terracotta, #b87560);
    }

    .research-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
        line-height: 1.4;
    }

    .research-manager {
        font-size: 0.95rem;
        margin-bottom: 1rem;
        color: var(--botanical-sepia, #8b7355);
    }

    .research-manager .label {
        font-weight: 600;
    }

    .research-progress {
        margin-top: 1.5rem;
    }

    .progress-label {
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        font-variant: small-caps;
    }

    .progress-bar {
        width: 100%;
        height: 12px;
        background: rgba(139, 115, 85, 0.2);
        border: 1px solid var(--botanical-sepia, #8b7355);
        border-radius: 6px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--botanical-sage, #87a878), var(--botanical-moss, #5a6e4f));
        transition: width 0.5s ease;
    }

    .research-binary {
        font-family: 'VT323', monospace;
        font-size: 0.85rem;
        color: var(--pixel-green, #00ff41);
        text-align: center;
        padding-top: 1rem;
        border-top: 1px dashed var(--botanical-sepia, #8b7355);
        margin-top: 1rem;
    }

    @media (max-width: 768px) {
        .research-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

